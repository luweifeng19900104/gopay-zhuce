# Runtime configuration template.
# Copy to config/runtime.env, then fill the live values that belong to this machine.

# Required only for live registration/worker runs.
# You can point at an existing SMSBower env file, set the key directly, or keep
# it in a local file and point to it.
OPAI_GOPAY_SMS_ENV_FILE=
OPAI_SMSBOWER_API_KEY=
OPAI_SMSBOWER_API_KEY_FILE=
OPAI_SMSBOWER_API_BASE_URL=https://smsbower.page
OPAI_SMSBOWER_SERVICE=ni
OPAI_SMSBOWER_COUNTRY=6

# Local Payment Inbox.
OPAI_PAYMENT_INBOX_HOST=127.0.0.1
OPAI_PAYMENT_INBOX_PORT=19080
OPAI_PAYMENT_INBOX_BASE_URL=http://127.0.0.1:19080
OPAI_PAYMENT_INBOX_PATH=config/payment_inbox.json

# Leave blank for local open access. Set both values if the inbox is exposed.
OPAI_PAYMENT_INBOX_BASIC_USER=
OPAI_PAYMENT_INBOX_BASIC_PASS=

# Worker defaults.
OPAI_GOPAY_POLL_INTERVAL=10
OPAI_GOPAY_MIN_REMAINING_SEC=300
OPAI_GOPAY_DEFAULT_PIN=147258
OPAI_GOPAY_MIN_BALANCE_RP=1
OPAI_GOPAY_ACCOUNT_TTL_SEC=1200
OPAI_GOPAY_ACCOUNTS_FILE=config/gopay_worker_accounts.json
OPAI_GPT_REGISTER_ROOT=gpt_register
OPAI_GPT_REGISTER_PYTHON=.venv/bin/python

# Optional proxy settings.
OPAI_GOPAY_REGISTER_PROXY=
OPAI_GOPAY_DEFAULT_PROXY=
OPAI_GOPAY_PROXY_TEMPLATE=

# GoPay protocol identity. Current recommended profile follows the newer
# reference build; comment these four lines to fall back to code defaults.
OPAI_GOPAY_APP_VERSION=2.10.0
OPAI_GOPAY_APP_BUILD=2100
OPAI_GOPAY_SUPPORT_APP_VERSION=2.10.0
OPAI_GOPAY_SUPPORT_APP_BUILD=2100

# Signup/CVS body compatibility switches. Current local-stable signup body uses
# client_name=gopay:consumer:app and signed_up_country=ID. If you want to test
# the reference profile, switch client_name to gopay_consumer_app and country to
# 62, then restart the inbox.
OPAI_GOPAY_SIGNUP_CLIENT_NAME=gopay:consumer:app
OPAI_GOPAY_SIGNED_UP_COUNTRY=ID
OPAI_GOPAY_CVS_DOUBLE_SLASH_INITIATE=1

# Device/fingerprint pool. New phone seeds use a no-repeat allocation until the
# local profile pool is exhausted.
OPAI_GOPAY_DEVICE_PROFILES_FILE=config/device_profiles.json
OPAI_GOPAY_DEVICE_PROFILE_ALLOCATIONS_FILE=config/device_profile_allocations.json

# Auto full-flow knobs.
OPAI_AUTO_FLOW_GOPAY_REGISTER_ATTEMPTS=8
OPAI_AUTO_FLOW_BALANCE_WAIT_SEC=180
OPAI_AUTO_FLOW_PAYMENT_TIMEOUT_SEC=900

# ---- 纯协议认证与支付（不启动模拟器） ----
# 支付和认证固定使用 protocol；mobile 仅表示协议请求使用安卓手机指纹。
OPAI_GOPAY_PAYMENT_MODE=protocol
OPAI_GOPAY_AUTH_MODE=protocol
# 设备模拟: mobile=安卓手机指纹(OkHttp TLS + 移动Chrome UA) / desktop=桌面Chrome
OPAI_GOPAY_DEVICE_SIM=mobile
OPAI_GOPAY_BROWSER_TIMEOUT=900
OPAI_GOPAY_STATUS_POLL_SECONDS=3
OPAI_GOPAY_BROWSER_REQUIRE_ID=1
# 本机 Clash 代理(HTTP混合端口)；GoPay 需要印尼住宅出口
OPAI_GOPAY_CLASH_ADDRESS=http://127.0.0.1:7897
# 支付默认代理；留空则支付时在网页手动填。推荐填印尼住宅代理
OPAI_GOPAY_DEFAULT_PROXY=
