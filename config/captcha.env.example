# Midtrans Alibaba CAPTCHA provider configuration（分享版模板）
# 复制为 config/captcha.env 后填入自己的 Solverify / 2Captcha 配置
OPAI_SOLVERIFY_API_KEY=
OPAI_SOLVERIFY_API_BASE_URL=https://solver.solverify.net
OPAI_SOLVERIFY_POLL_SEC=3
OPAI_SOLVERIFY_TIMEOUT_SEC=130
OPAI_2CAPTCHA_API_KEY=
OPAI_2CAPTCHA_API_BASE_URL=https://api.2captcha.com
OPAI_MIDTRANS_CAPTCHA_SCENE_ID=1mbz0gpl6
OPAI_MIDTRANS_CAPTCHA_PREFIX=y1rdnbp
OPAI_MIDTRANS_CAPTCHA_REGION=sgp
OPAI_MIDTRANS_CAPTCHA_API_GET_LIB=https://o.alicdn.com/captcha-frontend/aliyunCaptcha/AliyunCaptcha.js
OPAI_2CAPTCHA_POLL_SEC=10
OPAI_2CAPTCHA_TIMEOUT_SEC=180
OPAI_2CAPTCHA_MAX_ATTEMPTS=3
